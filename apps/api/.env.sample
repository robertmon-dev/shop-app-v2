# Copy to .env and fill in. `make setup` does this for you.
# .env is gitignored; never commit real secrets.

# ----- Rails -----
RAILS_ENV=development
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=debug
PORT=3000
WEB_CONCURRENCY=1
JOB_CONCURRENCY=1
SOLID_QUEUE_IN_PUMA=true

# ----- URL generation (mailers, Active Storage) -----
APP_HOST=http://localhost:3000
DEFAULT_URL_PROTOCOL=http
DEFAULT_URL_HOST=localhost
DEFAULT_URL_PORT=3000

# ----- PostgreSQL -----
# Host ports are chosen to avoid clashing with other local projects.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shop_on_rails_development
POSTGRES_TEST_DB=shop_on_rails_test

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ----- RabbitMQ -----
RABBITMQ_DEFAULT_HOST=localhost
RABBITMQ_DEFAULT_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_ERLANG_COOKIE=change-me-local-cookie
RABBITMQ_HEARTBEAT=5
RABBITMQ_FRAME_MAX=131072
RABBITMQ_AUTH_MECHANISM=PLAIN
RABBIT_TOPIC=orders.events

# ----- SMTP -----
# Defaults point at the Mailpit container (`make up`): UI on http://localhost:8025
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=localhost

# ----- Stripe -----
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ----- Twilio -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ----- Seeded admin (db/seeds.rb) -----
ADMIN_MAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ----- Auth -----
TOKEN_LIFETIME_HOURS=24

# ----- n8n -----
N8N_WEBHOOK_SECRET=

# ----- RabbitMQ consumer -----
RABBIT_CONSUMER_QUEUE=orders.events.shop

# ----- Invoice PDF -----
# Optional: absolute path to a TTF with Polish glyphs. Autodetected when unset.
INVOICE_PDF_FONT_PATH=
