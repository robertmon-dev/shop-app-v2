# Test-environment overrides. Loaded by dotenv before .env, so these win.
# Tracked in git on purpose: no secrets here.

RAILS_ENV=test

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shop_on_rails_test

# Separate Redis logical db so a test run never flushes development cache.
REDIS_URL=redis://localhost:6380/1

# Mail is captured by ActionMailer::Base.deliveries, never sent.
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_USERNAME=test
SMTP_PASSWORD=test
SMTP_DOMAIN=localhost

STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_PUBLISHABLE_KEY=pk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy

TWILIO_ACCOUNT_SID=ACdummydummydummydummydummydummy00
TWILIO_AUTH_TOKEN=dummydummydummydummydummydummy00
TWILIO_PHONE_NUMBER=+15005550006

ADMIN_MAIL=admin@example.com
ADMIN_PASSWORD=TestPassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

TOKEN_LIFETIME_HOURS=24

# ----- n8n -----
N8N_WEBHOOK_SECRET=test-n8n-secret

# ----- RabbitMQ consumer -----
RABBIT_CONSUMER_QUEUE=orders.events.shop

# ----- Invoice PDF -----
# Optional: absolute path to a TTF with Polish glyphs. Autodetected when unset.
INVOICE_PDF_FONT_PATH=
