{
  "name": "@shop/api-types",
  "private": true,
  "version": "0.0.0",
  "description": "Request and response types generated from the Rails OpenAPI document",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/swagger/v1/swagger.yaml -o src/schema.d.ts && openapi-ts && node scripts/registry.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.0",
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1"
  }
}
